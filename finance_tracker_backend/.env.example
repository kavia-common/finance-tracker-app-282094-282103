# Finance Tracker Backend - .env.example
# Copy to ".env" and adjust values as needed.

# Database configuration
# For local development the default SQLite file is fine. For Postgres/MySQL set full URL.
# Examples:
#   sqlite:///./data.db
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
#   mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite:///./data.db

# JWT configuration
# IMPORTANT: Change this in non-dev environments.
JWT_SECRET=change-me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - comma separated list of origins (no spaces), or * for all
# Example: http://localhost:3000,http://localhost:8080
CORS_ALLOW_ORIGINS=*

# Server host/port notes (configured via uvicorn not here typically)
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=8000
